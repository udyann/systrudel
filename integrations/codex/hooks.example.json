{
  "description": "systrudel local activity counters. No prompts, tool arguments, or transcripts are forwarded.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"__SYSTRUDEL_ROOT__/scripts/codex-hook.js\"", "timeout": 3 }] }]
  }
}
