# Copy to .env for local settings. The app also works without this file.
# Restart npm run dev after changing values. Use three different ports.
PHOTOSYNTH_UI_PORT=5173
PHOTOSYNTH_COMPANION_PORT=4317
PHOTOSYNTH_PREVIEW_PORT=4173

# Optional: executable used by npm run agent:check if codex is not on PATH.
# PHOTOSYNTH_CODEX_EXECUTABLE="C:/path/to/codex.exe"

# No API keys are required. The companion creates its own temporary token
# in .local/telemetry.json. Never put secrets in VITE_* variables: those are public.
